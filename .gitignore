.venv/
site/
__pycache__/
.mkdocs_cache/

# Generated at deploy time by scripts/translate_docs.py — never hand-edited,
# never committed, so French/Dutch can't drift from the English source.
docs/**/*.fr.md
docs/**/*.nl.md

# Content-addressed cache of past translations, restored across CI runs via
# actions/cache so an unchanged page is never re-translated. Never committed.
.translation-cache/
